  "schedules": [
    {
      "name": "oshepherd-reap-v1",
      "interval": "10 seconds",
      "command": "set statement_timeout='5s'; set lock_timeout='100ms'; select oshepherd.scheduled_sweep('reap');"
    },
    {
      "name": "oshepherd-purge-v1",
      "interval": "* * * * *",
      "command": "set statement_timeout='5s'; set lock_timeout='100ms'; select oshepherd.scheduled_sweep('purge'); delete from cron.job_run_details where runid in(select d.runid from cron.job_run_details d join cron.job j on j.jobid=d.jobid where j.jobname in('oshepherd-reap-v1','oshepherd-purge-v1') and j.username=current_user and d.end_time<clock_timestamp()-interval '2 days' order by d.runid limit 256);"
    }
  ]
